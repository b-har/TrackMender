# Line endings.  Git stores text with LF; these files are always checked out
# with the endings their tools write, whatever the local git settings are.
* text=auto

*.pas    text eol=crlf
*.dpr    text eol=crlf
*.dproj  text eol=crlf
*.fmx    text eol=crlf
*.lpr    text eol=crlf
*.lpi    text eol=crlf
*.lfm    text eol=crlf
*.bat    text eol=crlf
*.py     text eol=lf

# Never treated as text
*.res    binary
*.ico    binary
*.png    binary
